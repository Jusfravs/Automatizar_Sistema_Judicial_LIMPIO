# Requerida por las configuraciones operativas: la API resuelve el CAPTCHA.
# Si falla, solo hay una ventana visible de 30 segundos antes de revisión manual.
AUTOCAPTCHA_API_KEY=
# Opcional: solo si se cambia base_de_datos.motor a 'postgres'.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=casos_judiciales
POSTGRES_USER=judicial_app
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=
POSTGRES_SSLROOTCERT=

# Solo para crear la base y el rol; no se usa durante la operacion normal.
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=

# Auditoría procesal opcional con NVIDIA NIM; cargar en la sesión de PowerShell.
# Nunca guardar aquí una clave real ni incluirla en Git.
NVIDIA_API_KEY=
